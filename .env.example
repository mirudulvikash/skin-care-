# Aiven Managed PostgreSQL Cloud Database
AIVEN_DATABASE_URL=postgres://<user>:<password>@<host>:<port>/defaultdb?sslmode=require

# Authentication Session Secret
SESSION_SECRET=your_jwt_secret_key_here

# Resend API Key for Email Notifications
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev

# Hugging Face API Token (Optional)
HF_API_KEY=hf_your_read_token_here
