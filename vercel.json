{
  "version": 2,
  "framework": "nextjs",
  "functions": {
    "app/api/predict/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/scans/route.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
